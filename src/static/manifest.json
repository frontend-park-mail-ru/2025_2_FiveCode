  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#3399FF",
  "categories": ["productivity", "utilities"],
  "screenshots": [
    {
      "src": "/static/svg/icon_goose.svg",
      "sizes": "540x720",
      "type": "image/svg+xml",
      "form_factor": "narrow"
    },
    {
      "src": "/static/svg/icon_goose.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
