  "icons": [
    {
      "src": "/static/svg/icon_goose.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/static/svg/icon_goose.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/static/svg/icon_goose.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/static/svg/icon_goose.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
